{
  "name": "mealroulette-mobile-shell",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "cap:copy": "cap copy ios",
    "cap:sync": "cap sync ios",
    "cap:open": "cap open ios",
    "build:web": "pnpm --dir .. --filter frontend run build",
    "build:copy": "pnpm run build:web && cap copy ios",
    "build:sync": "pnpm run build:web && cap copy ios"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
