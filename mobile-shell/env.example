# Copy values into apps/frontend/.env.production.local (gitignored) or export before build.
# The mobile shell copies ../apps/frontend/dist — env is baked in at `pnpm --filter frontend build` time.

# Required on device: absolute URL to your API (same Wi‑Fi LAN IP, tunnel, or deployed host).
# Example: http://192.168.1.10:4000/graphql
VITE_GRAPHQL_URL=

# Optional: swipe analytics endpoint (defaults to /api/... relative — also set absolute for device).
# VITE_ANALYTICS_URL=http://192.168.1.10:4000/api/analytics/swipes
