{
  "name": "mealroulette",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "frontend": "pnpm --filter frontend dev",
    "api-gateway": "pnpm --filter api-gateway dev",
    "test": "pnpm -r run test",
    "test:services": "pnpm --filter recommendation-service run test && pnpm --filter nutrition-service run test && pnpm --filter analytics-service run test",
    "benchmark:recommendation": "pnpm --filter recommendation-service run build && pnpm --filter recommendation-service run benchmark",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint-config-prettier": "^9.1.0",
    "@types/node": "^20.10.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
