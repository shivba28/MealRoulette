PORT=4000
NODE_ENV=development

# Comma-separated browser origins (must match where the SPA is opened).
FRONTEND_ORIGIN=http://localhost:3000
# You can also allow Vercel preview domains:
# FRONTEND_ORIGIN=https://yourapp.vercel.app,https://*.vercel.app

# SPA URL after Google redirects back to the API OAuth callback.
FRONTEND_URL=http://localhost:3000

# Google Cloud Console → OAuth 2.0 Client (Web). Authorized redirect URI must match exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Long random string: signs cookies and encrypts refresh tokens in data/sessions.json
SESSION_SECRET=change-this-to-a-long-random-string

# If sign-in succeeds but sync fails with no_refresh_token, set this and try again once:
# GOOGLE_OAUTH_PROMPT=consent

# For cross-site deployments (e.g. Vercel frontend -> Render API), you must use SameSite=None cookies:
# COOKIE_SAMESITE=none

# Optional: where to store sessions (relative to apps/api-gateway when you run the server)
# DATA_DIR=data
