# Optional: free LLM API keys for dynamic meal recommendations.
# Without these, the app uses built-in mock recipes (still shows 10 cards with ingredients/steps).

# Groq (recommended): free tier, fast. Get a key at https://console.groq.com
VITE_GROQ_API_KEY=

# Hugging Face: free tier. Get a token at https://huggingface.co/settings/tokens (Inference API)
VITE_HF_TOKEN=

# YouTube Data API v3 key — get one free at https://console.cloud.google.com (enable YouTube Data API v3)
VITE_YOUTUBE_API_KEY=
